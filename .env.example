# Copy to .env and adjust if needed — docker-compose.yml already has
# working defaults for everything here, so `docker compose up` works
# without this file too. This is only for overriding those defaults.

# Postgres
POSTGRES_USER=fixboard
POSTGRES_PASSWORD=fixboard
POSTGRES_DB=fixboard
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=3000
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d

# Frontend (served on this host port; baked into the build as the API URL
# the browser will call, so this only takes effect on `docker compose build`)
FRONTEND_PORT=8090
