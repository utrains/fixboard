PORT=3000

# PostgreSQL connection
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fixboard

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Where uploaded attachments are written/served from. In Docker this is a
# mounted volume; on Kubernetes it becomes an EFS-backed PVC at the same path.
UPLOADS_DIR=./uploads
